#!/bin/bash
# SLURM job: task1, 16 MPI processes = 8 + 8 on two nodes (same core count and node count as task2_np4x4_2node).
#
# Layout expected on CAAS (same as the git checkout):
#   ~/parallel-primes/parallel-primes-mpi/caas/task1_np16_2node.job   <- submit from this directory
#   ~/parallel-primes/parallel-primes-mpi/task1.c, task2.c, Makefile, bench/run_bench.sh
#   ~/parallel-primes/parallel-primes-pthreads-openmp/task1.c, task2.c, task3.c   (baseline programs)
#
#   sbatch task1_np16_2node.job
#   squeue -u $USER          # wait for it to finish (10 min limit, 1 job at a time)
#   cat task1_np16_2node.*.out
# Results are appended to ../bench/results/caas-2node.csv (unified schema), so
# they plot with the same plot.py as the local runs:
#   python bench/plot.py bench/results/caas-2node.csv --site caas-2node
#
#SBATCH --job-name=task1_np16_2node
#SBATCH --time=00:10:00
#SBATCH --mem=16G
#SBATCH --ntasks=16
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=task1_np16_2node.%j.out
#SBATCH --partition=defq

module load openmpi/4.1.5-gcc-11.2.0-ux65npg
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
cd "$SLURM_SUBMIT_DIR"

# Every run inside the allocation is launched with srun (not mpirun), so the
# process count / placement comes from the #SBATCH lines above.
SITE=caas-2node CORES=16 REPEATS=3 LAUNCHER=srun OUT_DIR=/tmp/lab2_$USER \
    bash ../bench/run_bench.sh caas-mpi
